PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bitstek_learning
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CLIENT_URL=http://localhost:5173
SEED_ADMIN_EMAIL=admin@bitsteklearning.local
SEED_ADMIN_PASSWORD=CHANGE_THIS_BEFORE_RUNNING_SEED

# Frontend base URL for user invite links
PUBLIC_APP_URL=http://localhost:5173
# SMTP setup (required only for Send Setup Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Private filesystem storage, keep outside any publicly served web root.
# Persist this directory when deploying with Docker/PM2.
PRIVATE_UPLOAD_DIR=./private_uploads
