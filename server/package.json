{
  "name": "bitstek-learning-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json --delay 800ms src/index.js",
    "start": "node src/index.js",
    "seed": "node scripts/seed.js",
    "check": "node --check src/index.js",
    "test": "node --test tests/*.test.js",
    "dev:node": "node --watch src/index.js",
    "reset:admin": "node scripts/reset-admin.js",
    "doctor": "node scripts/doctor.js",
    "smoke": "node scripts/smoke-api.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^8.14.0",
    "multer": "^2.0.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
